{
    "logo" : {
        "type"	    : "file",
	"source"    : "$XDG_CONFIG_HOME/fastfetch/snowflake.txt",
	"color"	    : {
	    "1"		: "blue"
	  	}
	},

    "display" : {
	"separator" : " :: "
	 },

 

  "modules": [
	  {
		"type"    : "title",
		"key"     : " ",
	   	"format"  : ":: {#1;32}{user-name}{#}@{#3;32}{host-name}{#} ::"
	  },
	  
	  {
		"type"    : "custom",
		"key"	  : " "
	  },

	  {
		"type"    : "kernel",
		"key"     : "KRN",
		"format"  : "{release}, arch: {arch}"
	  },
	  
	  {
		"type"    : "packages",
		"key"     : "PKG"
	  },


	  {
		"type"    : "wm",
		"key"     : " WM"
	  },

	  {
		"type"    : "terminal",
		"key"     : "TRM",
		"format"  : "{exe}"
	  },


	  {
		"type"    : "cpu",
		"key"     : "CPU",
		"format"  : "{name}"
	  },


	  {
		"type"    : "gpu",
		"key"     : "GPU",
		"format"  : "{name}"
	  },


	  {
		"type"    : "memory",
		"key"     : "MEM",
		"format"  : "{used} / {total}"
	  },


	  {
		"type"    : "disk",
		"key"     : "DSK",
		"format"  : "({mountpoint}): {size-used} / {size-total}"
	  },

	  {
		"type"    : "custom",
		"key"	  : " "
	  },

	  {
		"type"    : "custom",
		"key"	  : " ",
		"format"  : "{#31}██ {#32}██ {#33}██ {#34}██ {#35}██ {#36}██ {#37}██ {#38}██{#}"
	  }

  ]
}
