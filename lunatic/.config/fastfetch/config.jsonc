{
    "logo" : {
        "type"	    : "file",
	"source"    : "$XDG_CONFIG_HOME/fastfetch/snowflake.txt",
	"color"	    : {
	    "1"		: "blue"
	  	}
	},

    "display" : {
	"separator" : " :: "
	 },

 

  "modules": [
	  {
		"type"    : "title",
		"key"     : " ",
	   	"format"  : ":: {#1;32}{user-name}{#}@{#3;32}{host-name}{#} ::"
	  },
	  
	  {
		"type"    : "custom",
		"key"	  : " "
	  },

	  {
		"type"    : "kernel",
		"key"     : "KRN",
		"format"  : "{release}, arch: {arch}"
	  },
	  
	  {
		"type"    : "packages",
		"key"     : "PKG"
	  },

	  {"type": "custom"},
	  {"type": "custom"},
	  {"type": "custom"},
	  {"type": "custom"},
	  {"type": "custom"},
	  {"type": "custom"},
	  {"type": "custom"}
