{
    "logo" : {
        "position"  : "top",
        "type"	    : "file",
	    "source"    : "$XDG_CONFIG_HOME/fastfetch/Jokerge.txt",
        "color"     : {
            "1"     : "#FFFFFF"
        },
        "padding"   : {
            "left"  : 4
        }
    },

    "display" : {
	"separator" : " :: "
	 },

 

  "modules": [
	  {
		"type"    : "title",
		"key"     : " ",
	   	"format"  : "     {#38;5;1}{#48;5;9}▀{#}{#38;5;2}{#48;5;10}▀{#}{#38;5;3}{#48;5;11}▀{#}{#38;5;4}{#48;5;12}▀{#} {#1;32}{user-name}{#}@{#3;32}{host-name}{#} {#38;5;5}{#48;5;13}▀{#}{#38;5;6}{#48;5;14}▀{#}{#38;5;7}{#48;5;15}▀{#}{#38;5;8}{#48;5;16}▀{#}"
	  },
	  
	  {
		"type"    : "custom",
		"key"	  : " "
	  },

	  {
		"type"    : "kernel",
		"key"     : "  KRN",
		"format"  : "{release}, arch: {arch}"
	  },
	  
	  {
		"type"    : "packages",
		"key"     : "  PKG"
	  },


	  {
		"type"    : "wm",
		"key"     : "   WM"
	  },

	  {
		"type"    : "terminal",
		"key"     : "  TRM",
		"format"  : "{exe}"
	  },


	  {
		"type"    : "cpu",
		"key"     : "  CPU",
		"format"  : "{name}"
	  },


	  {
		"type"    : "gpu",
		"key"     : "  GPU",
		"format"  : "{name}"
	  },


	  {
		"type"    : "memory",
		"key"     : "  MEM",
		"format"  : "{used} / {total}"
	  },


	  {
		"type"    : "disk",
		"key"     : "  DSK",
		"format"  : "({mountpoint}): {size-used} / {size-total}"
	  },

	  {
		"type"    : "custom",
		"key"	  : " "
	  }
  ]
}
